+    /// True when this copy's ordinary `mutate` reuses the projection cache.
+    /// Both copies still have `cached_projection`, used by append_message_update.
+    pub const MUTATE_USES_CACHE: bool = false;
+
+    #[derive(Default)]
+    struct Entry {
+        count: u64,
+        total_ns: u64,
+        max_ns: u64,
+    }
+
+    #[derive(Default)]
+    struct Acc {
+        phases: BTreeMap<(&'static str, &'static str), Entry>,
+        hits: u64,
+        misses: u64,
+        cached_calls: u64,
+        boundaries: u64,
+    }
+
+    thread_local! {
+        static ACC: RefCell<Acc> = RefCell::new(Acc::default());
+        static OP: RefCell<&'static str> = RefCell::new("unlabeled");
+    }
+
+    pub fn set_op(op: &'static str) {
+        OP.with(|value| *value.borrow_mut() = op);
+    }
+
+    pub fn reset() {
+        ACC.with(|acc| *acc.borrow_mut() = Acc::default());
+    }
+
+    fn note_at(acc: &mut Acc, op: &'static str, phase: &'static str, nanos: u64) {
+        acc.boundaries = acc.boundaries.saturating_add(1);
+        let entry = acc.phases.entry((op, phase)).or_default();
+        entry.count = entry.count.saturating_add(1);
+        entry.total_ns = entry.total_ns.saturating_add(nanos);
+        entry.max_ns = entry.max_ns.max(nanos);
+    }
+
+    pub fn note(phase: &'static str, start: Instant) {
+        let nanos = u64::try_from(start.elapsed().as_nanos()).unwrap_or(u64::MAX);
+        let op = OP.with(|value| *value.borrow());
+        ACC.with(|acc| note_at(&mut acc.borrow_mut(), op, phase, nanos));
+    }
+
+    pub fn hit() {
+        ACC.with(|acc| {
+            let mut acc = acc.borrow_mut();
+            acc.hits = acc.hits.saturating_add(1);
+        });
+    }
+
+    pub fn miss() {
+        ACC.with(|acc| {
+            let mut acc = acc.borrow_mut();
+            acc.misses = acc.misses.saturating_add(1);
+        });
+    }
+
+    pub fn cached_call() {
+        ACC.with(|acc| {
+            let mut acc = acc.borrow_mut();
+            acc.cached_calls = acc.cached_calls.saturating_add(1);
+        });
+    }
+
+    fn summarize(mut values: Vec<u64>) -> serde_json::Value {
+        if values.is_empty() {
+            return serde_json::json!({"samples": 0});
+        }
+        values.sort_unstable();
+        let count = values.len();
+        let total: u64 = values.iter().sum();
+        let pick = |quantile: f64| -> u64 {
+            let rank = (quantile * count as f64).ceil() as usize;
+            values[rank.saturating_sub(1).min(count - 1)]
+        };
+        serde_json::json!({
+            "samples": count,
+            "min_ns": values[0],
+            "p50_ns": pick(0.50),
+            "p90_ns": pick(0.90),
+            "max_ns": values[count - 1],
+            "mean_ns": total / u64::try_from(count).unwrap_or(1),
+        })
+    }
+
+    /// Synthetic timer calibration only. It is reset before any workload runs
+    /// and is never mixed into workload phase samples.
+    pub fn calibrate() -> serde_json::Value {
+        let mut pair = Vec::with_capacity(1000);
+        for _ in 0..1000 {
+            let start = Instant::now();
+            let nanos = u64::try_from(start.elapsed().as_nanos()).unwrap_or(u64::MAX);
+            pair.push(nanos);
+        }
+        let mut note_path = Vec::with_capacity(1000);
+        for _ in 0..1000 {
+            let start = Instant::now();
+            note("calibration", start);
+            let nanos = u64::try_from(start.elapsed().as_nanos()).unwrap_or(u64::MAX);
+            note_path.push(nanos);
+        }
+        reset();
+        serde_json::json!({
+            "calibration_only": true,
+            "not_part_of_workload": true,
+            "iterations": 1000,
+            "timer_pair_ns": summarize(pair),
+            "note_path_ns": summarize(note_path),
+            "warning": "Synthetic timer costs on the reporting thread; do not compare with workload phases."
+        })
+    }
+
+    fn relation(phase: &str) -> &'static str {
+        match phase {
+            "total" | "cached_projection" | "decode" | "persist" | "load" => "parent",
+            _ => "exclusive",
+        }
+    }
+
+    pub fn snapshot() -> serde_json::Value {
+        ACC.with(|acc| {
+            let acc = acc.borrow();
+            let mut phases = serde_json::Map::new();
+            for ((op, phase), entry) in &acc.phases {
+                phases.insert(
+                    format!("{op}.{phase}"),
+                    serde_json::json!({
+                        "operation": op,
+                        "phase": phase,
+                        "relation": relation(phase),
+                        "count": entry.count,
+                        "total_ns": entry.total_ns,
+                        "max_ns": entry.max_ns,
+                        "mean_ns": if entry.count == 0 { 0 } else { entry.total_ns / entry.count },
+                    }),
+                );
+            }
+            serde_json::json!({
+                "thread": format!("{:?}", std::thread::current().id()),
+                "mutate_uses_cache": MUTATE_USES_CACHE,
+                "timed_boundaries": acc.boundaries,
+                "phases": phases,
+                "cache": {
+                    "hits": acc.hits,
+                    "misses": acc.misses,
+                    "cached_projection_calls": acc.cached_calls,
+                    "hits_plus_misses_equals_calls": acc.hits.saturating_add(acc.misses) == acc.cached_calls,
+                },
+                "relation_policy": {
+                    "parents": ["total", "cached_projection", "decode", "persist", "load"],
+                    "exclusive": [
+                        "lock_wait", "begin_immediate", "select_projection", "cache_lock",
+                        "wait_log_hit", "cache_take", "make_mut", "verify_lease",
+                        "apply_event", "increment", "change", "validate_wait_bindings",
+                        "encode_record", "encode_projection", "encode_lifecycle",
+                        "sql_insert", "sql_update", "sql_update_returning",
+                        "readback_projection", "commit", "publish_cache",
+                        "json", "input", "identity", "wait_bindings", "wait_log"
+                    ],
+                    "rule": "A parent phase contains the exclusive phases recorded under the same operation. Never sum parent and child entries."
+                },
+                "notes": [
+                    "Counters and timings come from the actual in-process call path, not from the workload plan.",
+                    "Thread-local aggregation; only the reporting thread is represented unless the workload uses more threads.",
+                    "Early-error calls record only the phases reached before the error; totals are recorded only on success.",
+                    "commit includes the WAL write, fsync, and any automatic checkpoint. fsync is not separated.",
+                    "SQLite statement phases include SQLite-side JSON work such as json_set in append_message_update."
+                ]
+            })
+        })
+    }
+}
