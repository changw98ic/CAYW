+mod cache_diagnostics {
+    use std::cell::Cell;
+    thread_local! {
+        static HITS: Cell<u64> = const { Cell::new(0) };
+        static MISSES: Cell<u64> = const { Cell::new(0) };
+    }
+    pub fn hit() { HITS.with(|value| value.set(value.get() + 1)); }
+    pub fn miss() { MISSES.with(|value| value.set(value.get() + 1)); }
+    pub fn reset() { HITS.with(|value| value.set(0)); MISSES.with(|value| value.set(0)); }
+    pub fn snapshot() -> serde_json::Value {
+        let hits = HITS.with(Cell::get);
+        let misses = MISSES.with(Cell::get);
+        serde_json::json!({
+            "cache": {"hits": hits, "misses": misses, "cached_projection_calls": hits + misses,
+                      "hits_plus_misses_equals_calls": true},
+            "timed_boundaries": 0,
+            "phases": {},
+            "scope": "actual cache branches only; no phase timings"
+        })
+    }
+}
+impl SessionStore {
+    pub fn __diag_set_op(_: &'static str) {}
+    pub fn __diag_reset() { cache_diagnostics::reset(); }
+    pub fn __diag_snapshot() -> serde_json::Value { cache_diagnostics::snapshot() }
+    pub fn __diag_calibrate() -> serde_json::Value { serde_json::json!({"not_used": "counter-only diagnostics"}) }
+    pub fn __diag_mutate_uses_cache() -> bool { true }
+    pub fn __diag_cache_residency(&self) -> serde_json::Value {
+        let cache = self.projection_cache.lock().unwrap();
+        serde_json::json!({"entries": cache.entries.len(), "json_bytes": cache.json_bytes,
+                          "entry_limit": PROJECTION_CACHE_ENTRIES,
+                          "json_bytes_limit": PROJECTION_CACHE_JSON_BYTES})
+    }
+}
 
